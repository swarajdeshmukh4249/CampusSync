# Copy to .env and fill in. .env is gitignored — keep it that way.

# Supabase — the service_role key is server-side only, never ship it to a client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Encrypts each student's VOLP password at rest, so CampusSync can sign in and
# submit on their behalf at a scheduled time. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, scheduled submissions fail once the VOLP session cookies expire.
CAMPUSSYNC_SECRET_KEY=

# Optional — largest file a student may queue for submission (MB).
CAMPUSSYNC_MAX_UPLOAD_MB=25

# Optional — WhatsApp reminders via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Optional — push notifications via Firebase.
FIREBASE_CREDENTIALS_PATH=firebase-key.json
